<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Android front end. Build with the .NET 9 SDK and the "android" workload:
      dotnet publish ZeXal.Android/ZeXal.Android.csproj -c Release
    Not part of ZeXal.sln: Visual Studio 2010 can't open SDK style projects.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ZeXal.Android</RootNamespace>
    <AssemblyName>ZeXal.Android</AssemblyName>
    <ApplicationId>io.github.delfioh.zexal</ApplicationId>
    <ApplicationTitle>ZeXal</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The old projects keep their own AssemblyInfo; don't generate a second one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618;CA1416;CA1422</NoWarn>
  </PropertyGroup>

  <!-- The emulator core is shared as source with the desktop projects -->
  <ItemGroup>
    <Compile Include="..\ZeXal.CPUCore\**\*.cs" Exclude="..\ZeXal.CPUCore\Properties\**;..\ZeXal.CPUCore\obj\**;..\ZeXal.CPUCore\bin\**" LinkBase="Core\CPUCore" />
    <Compile Include="..\ZeXal.DMG\**\*.cs" Exclude="..\ZeXal.DMG\Properties\**;..\ZeXal.DMG\obj\**;..\ZeXal.DMG\bin\**" LinkBase="Core\DMG" />
  </ItemGroup>

</Project>
